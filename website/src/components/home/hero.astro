---
import { Code, Icon } from "@astrojs/starlight/components";
import Link from "@typespec/astro-utils/components/link.astro";

const example = `import "@typespec/http";

using TypeSpec.Http;

@service(#{ title: "Widget service" })
@server("https://example.com", "Service endpoint")
namespace Widgets;

model Widget {
  id: string;
  name: string;
}

@route("/widgets/{id}")
@get
op getWidget(@path id: string): Widget;`;
---

<section class="hero" aria-labelledby="_top">
  <div class="copy">
    <p class="eyebrow">TypeSpec for Azure</p>
    <h1 id="_top" data-page-title>
      Design your API.
      <br />
      Build for Azure.
    </h1>
    <p class="tagline">
      Define your service once. Generate OpenAPI and client libraries with Azure's shared patterns
      and guidelines.
    </p>
    <div class="actions">
      <Link class="primary" href="/docs/getstarted/installation">
        Get started <Icon name="right-arrow" />
      </Link>
      <Link class="secondary" href="/playground">
        Try playground <Icon name="right-arrow" />
      </Link>
    </div>
    <a class="language-link" href="https://typespec.io/docs/">
      New to TypeSpec? Learn the language <Icon name="external" />
    </a>
  </div>
  <div class="example">
    <Code code={example} lang="typespec" title="main.tsp" />
    <div class="outputs">
      <span>One definition. Multiple outputs.</span>
      <div class="output-links">
        <Link href="/docs/emitters/typespec-autorest">OpenAPI</Link>
        <Link href="/docs/emitters/clients/typespec-python/reference">Python</Link>
        <Link href="/docs/emitters/clients/typespec-ts/reference">JavaScript</Link>
        <Link href="/docs/emitters/clients/typespec-csharp/reference">C#</Link>
        <Link href="/docs/emitters/clients/typespec-java/reference">Java</Link>
        <Link href="/docs/emitters/clients/typespec-go/reference">Go</Link>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    align-items: center;
    gap: 2rem;
    padding-block: 2rem 3rem;
  }

  .copy {
    min-width: 0;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--colorBrandForeground1);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    color: var(--colorNeutralForeground1);
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 650;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }

  .tagline {
    max-width: 40ch;
    margin-block: 1.25rem;
    color: var(--colorNeutralForeground2);
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block: 1.5rem;
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--colorNeutralStroke1);
    border-radius: var(--borderRadiusLarge);
    text-decoration: none;
    font-weight: 600;
  }

  .actions .primary {
    background: var(--colorBrandBackground);
    border-color: var(--colorBrandBackground);
    color: var(--colorNeutralForegroundOnBrand);
  }

  .actions .primary:hover {
    background: var(--colorBrandBackgroundHover);
  }

  .secondary {
    color: var(--colorNeutralForeground1);
  }

  .secondary:hover {
    background: var(--colorNeutralBackground1Hover);
  }

  .language-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--colorNeutralForeground2);
    font-size: 0.875rem;
  }

  .example {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--colorNeutralStroke1);
    border-radius: var(--borderRadiusXLarge);
    box-shadow: var(--shadow8);
  }

  .example :global(.expressive-code .frame) {
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .outputs {
    padding: 1rem;
    border-top: 1px solid var(--colorNeutralStroke1);
    background: var(--colorNeutralBackground2);
    color: var(--colorNeutralForeground2);
    font-size: 0.875rem;
  }

  .output-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 0.5rem;
  }

  .output-links a {
    color: var(--colorBrandForeground1);
  }

  a:focus-visible {
    outline: 2px solid var(--colorBrandStroke1);
    outline-offset: 3px;
  }

  @media (min-width: 50rem) {
    .hero {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }
</style>
