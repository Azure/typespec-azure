---
import Search from "@astrojs/starlight/components/Search.astro";
---

<Search />

<style is:global>
  site-search {
    --__sl-font: var(--fontFamilyBase);
    --sl-text-2xs: var(--fontSizeBase200);
    --sl-text-sm: var(--fontSizeBase300);
    --sl-text-xl: var(--fontSizeBase500);
    --sl-color-white: var(--colorNeutralForeground1);
    --sl-color-gray-1: var(--colorNeutralForeground1);
    --sl-color-gray-2: var(--colorNeutralForeground2);
    --sl-color-gray-3: var(--colorNeutralForeground3);
    --sl-color-gray-4: var(--colorNeutralStroke2);
    --sl-color-gray-5: var(--colorNeutralStroke1);
    --sl-color-gray-6: var(--colorNeutralBackground2);
    --sl-color-black: var(--colorNeutralBackground1);
    --sl-color-text: var(--colorNeutralForeground1);
    --sl-color-text-accent: var(--colorBrandForeground1);
    --sl-color-text-invert: var(--colorNeutralForegroundOnBrand);
    --sl-color-accent: var(--colorBrandStroke1);
    --sl-color-accent-high: var(--colorBrandStroke1);
    --sl-color-accent-low: var(--colorNeutralBackground1Hover);
    --sl-shadow-lg: var(--shadow64);
  }

  site-search > button {
    border-radius: var(--borderRadiusMedium);
  }

  site-search .dialog-frame,
  site-search button[data-close-modal] {
    display: flex;
  }

  site-search > button > span,
  site-search > button > kbd {
    display: none;
  }

  site-search dialog::backdrop {
    background-color: var(--colorNeutralBackgroundAlpha);
  }

  @media (min-width: 50rem) {
    site-search dialog {
      margin: 4rem auto auto;
    }

    site-search > button > span {
      display: block;
    }

    site-search > button > kbd {
      display: flex;
    }

    site-search button[data-close-modal] {
      display: none;
    }
  }
</style>
