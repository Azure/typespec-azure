---
import { Icon } from "@astrojs/starlight/components";
import Link from "@typespec/astro-utils/components/link.astro";
import ThemePicker from "@typespec/astro-utils/components/theme-picker.astro";
import { baseUrl } from "@typespec/astro-utils/utils/base-url";
import Search from "./search.astro";

const pathname = Astro.url.pathname.slice(import.meta.env.BASE_URL.replace(/\/$/, "").length);
const links = [
  { label: "Docs", href: "/docs/intro", prefix: "/docs/" },
  { label: "Playground", href: "/playground", prefix: "/playground" },
  { label: "SDK support", href: "/can-i-use/http", prefix: "/can-i-use/" },
];
const tools = [
  { label: "Benchmarks", href: "/benchmarks", prefix: "/benchmarks" },
  { label: "TypeSpec language docs", href: "https://typespec.io/docs", prefix: undefined },
];
const isCurrent = (prefix: string | undefined) => prefix && pathname.startsWith(prefix);
---

<nav aria-label="Main" class="navbar">
  <Link href="/" class="brand">
    <img class="brand-icon" src={baseUrl("/azure.svg")} alt="" width="32" height="32" />
    <b>TypeSpec Azure</b>
  </Link>

  <div class="desktop-nav">
    {links.map(({ label, href, prefix }) => (
      <Link class="nav-link" href={href} aria-current={isCurrent(prefix) ? "true" : undefined}>
        {label}
      </Link>
    ))}
    <details class="tools header-menu">
      <summary
        class:list={["nav-link", { current: tools.some(({ prefix }) => isCurrent(prefix)) }]}
      >
        Tools <Icon name="down-caret" />
      </summary>
      <div class="tools-panel">
        {tools.map(({ label, href, prefix }) => (
          <Link class="nav-link" href={href} aria-current={isCurrent(prefix) ? "page" : undefined}>
            {label}
            {!prefix && <Icon name="external" />}
          </Link>
        ))}
      </div>
    </details>
  </div>

  <div class="desktop-utilities">
    <Link
      class="icon-link"
      href="https://github.com/Azure/typespec-azure"
      aria-label="TypeSpec Azure on GitHub"
      title="TypeSpec Azure on GitHub"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="github" />
    </Link>
    <Link
      class="icon-link"
      href="https://aka.ms/typespec/discord"
      aria-label="TypeSpec community on Discord"
      title="TypeSpec community on Discord"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="discord" />
    </Link>
    <ThemePicker />
  </div>

  <Search />

  <details class="site-menu header-menu">
    <summary class="nav-link" aria-label="Site navigation" title="Site navigation">
      Site <Icon name="down-caret" />
    </summary>
    <div class="site-panel">
      {links.map(({ label, href, prefix }) => (
        <Link class="nav-link" href={href} aria-current={isCurrent(prefix) ? "true" : undefined}>
          {label}
        </Link>
      ))}
      <span class="group-label">Tools</span>
      {tools.map(({ label, href, prefix }) => (
        <Link class="nav-link" href={href} aria-current={isCurrent(prefix) ? "page" : undefined}>
          {label}
          {!prefix && <Icon name="external" />}
        </Link>
      ))}
      <div class="mobile-utilities">
        <Link href="https://github.com/Azure/typespec-azure">GitHub</Link>
        <Link href="https://aka.ms/typespec/discord">Discord</Link>
        <ThemePicker />
      </div>
    </div>
  </details>
</nav>

<script>
  const menus = document.querySelectorAll<HTMLDetailsElement>(".header-menu");
  const closeMenus = () => menus.forEach((menu) => (menu.open = false));

  document.addEventListener("click", (event) => {
    for (const menu of menus) {
      if (!menu.contains(event.target as Node)) menu.open = false;
    }
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    for (const menu of menus) {
      if (!menu.open) continue;
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
  window.matchMedia("(min-width: 64rem)").addEventListener("change", closeMenus);

  const sidebar = document.getElementById("starlight__sidebar");
  sidebar?.addEventListener("beforetoggle", (event) => {
    if ((event as ToggleEvent).newState === "open") closeMenus();
  });
  for (const menu of menus) {
    menu.addEventListener("toggle", () => {
      if (menu.open && sidebar?.matches(":popover-open")) sidebar.hidePopover();
    });
  }
</script>

<style>
  .navbar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: var(--header-height);
    padding: 0.5rem 1rem;
    background: var(--colorNeutralBackground3);
    box-shadow: var(--shadow4);
    color: var(--colorNeutralForeground1);
  }

  .brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 0.25rem;
    margin-inline-end: auto;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand-icon {
    width: 32px;
    height: 32px;
  }

  .desktop-nav,
  .desktop-utilities {
    display: none;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    padding: 0.375rem 0.625rem;
    border-radius: var(--borderRadiusMedium);
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .nav-link:hover,
  .icon-link:hover {
    background: var(--colorNeutralBackground3Hover);
  }

  .nav-link[aria-current],
  .current {
    background: var(--colorBrandBackground2);
    color: var(--colorBrandForeground1);
    font-weight: 600;
  }

  a:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--colorBrandStroke1);
    outline-offset: 2px;
  }

  summary {
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  details[open] > summary :global(svg) {
    transform: rotate(180deg);
  }

  .site-panel,
  .tools-panel {
    padding: 0.75rem;
    border: 1px solid var(--colorNeutralStroke1);
    background: var(--colorNeutralBackground1);
    box-shadow: var(--shadow16);
  }

  .site-panel {
    position: absolute;
    inset-inline: 0;
    top: var(--header-height);
    max-height: calc(100dvh - var(--header-height));
    overflow-y: auto;
  }

  .site-panel .nav-link {
    min-height: 2.75rem;
  }

  .group-label {
    display: block;
    margin-top: 0.5rem;
    padding: 0.625rem;
    color: var(--colorNeutralForeground3);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .mobile-utilities {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.75rem;
    padding: 0.75rem 0.625rem 0;
    border-top: 1px solid var(--colorNeutralStroke1);
  }

  .mobile-utilities a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: inherit;
  }

  @media (max-width: 49.999rem) {
    :global([data-has-sidebar]) .navbar {
      padding-inline-end: 3.25rem;
    }
  }

  @media (max-width: 25rem) {
    .navbar {
      gap: 0.25rem;
      padding-inline: 0.5rem;
    }

    .brand {
      font-size: 0.875rem;
    }

    .site-menu > summary {
      padding-inline: 0.375rem;
    }
  }

  @media (min-width: 64rem) {
    .brand {
      margin-inline-end: 0.75rem;
    }

    .desktop-nav,
    .desktop-utilities {
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    .desktop-nav {
      flex: 1;
    }

    .desktop-utilities {
      gap: 0.5rem;
      margin-inline-end: 0.25rem;
    }

    .site-menu {
      display: none;
    }

    .tools {
      position: relative;
    }

    .tools-panel {
      position: absolute;
      top: calc(100% + 0.5rem);
      inset-inline-start: 0;
      min-width: 14rem;
      border-radius: var(--borderRadiusMedium);
    }

    .icon-link {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: var(--borderRadiusMedium);
      color: inherit;
      font-size: 1.375rem;
    }
  }
</style>
